$TTL 604800
@       IN      SOA     dns.raul.test. admin.raul.test. (
                        2026112201 ; Serial
                        604800     ; Refresh
                        86400      ; Retry
                        2419200    ; Expire
                        604800 )   ; Negative cache TTL

@       IN      NS      dns.raul.test.
5       IN      PTR     dns.raul.test.
6       IN      PTR     ansible.raul.test.
7       IN      PTR     negocio.raul.test.
