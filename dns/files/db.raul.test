$TTL 604800
@       IN      SOA     dns.raul.test. admin.raul.test. (
                        2026112201 ; Serial
                        604800     ; Refresh
                        86400      ; Retry
                        2419200    ; Expire
                        604800 )   ; Negative cache TTL

@       IN      NS      dns.raul.test.
dns     IN      A       192.168.57.5
ansible IN      A       192.168.57.6
negocio IN      A       192.168.57.7
www     IN      CNAME   negocio.raul.test.
ftp     IN      CNAME   negocio.raul.test.
